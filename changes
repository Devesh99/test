+// =====================================================================================================================
+// Builds the LLPC resource mapping for the critical section lock buffer.
+// Uses DescriptorBufferCompact (2 DWORDs = raw 64-bit BDA) to pass the GPU VA inline.
+void PipelineLayout::BuildLlpcCriticalSectionMapping(
+    const uint32_t                 stageMask,
+    const uint32_t                 offsetInDwords,
+    const uint32_t                 sizeInDwords,
+    Vkgc::ResourceMappingRootNode* pRootNode,
+    uint32_t*                      pRootNodeCount)
+{
+    // DescriptorBufferCompact: 2 DWORDs holding the raw 64-bit GPU VA
+    pRootNode->node.type               = Vkgc::ResourceMappingNodeType::DescriptorBufferCompact;
+    pRootNode->node.offsetInDwords     = offsetInDwords;
+    pRootNode->node.sizeInDwords       = sizeInDwords;
+    pRootNode->node.srdRange.set       = Vkgc::InternalDescriptorSetId;
+    pRootNode->node.srdRange.binding   = Vkgc::CriticalSectionBufferBindingId;
+    pRootNode->visibility              = stageMask;
+
+    ++(*pRootNodeCount);
+}
