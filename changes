@@ -1486,2 +1489,44 @@
 
+    // Allocate critical section lock buffer (always enabled, pre-allocated for max 4K resolution)
+    if (result == VK_SUCCESS)
+    {
+        // Default: allocate for max 4K resolution (3840 x 2160 x 4 bytes = ~33MB)
+        // Each pixel gets a uint32_t lock word for atomic compare-and-swap
+        constexpr Pal::gpusize maxWidth  = 3840;
+        constexpr Pal::gpusize maxHeight = 2160;
+        m_criticalSectionBufferSize = maxWidth * maxHeight * sizeof(uint32_t);
+
+        InternalMemCreateInfo allocInfo = {};
+        allocInfo.pal.size      = m_criticalSectionBufferSize;
+        allocInfo.pal.alignment = 256; // 256-byte alignment for GPU atomics
+        allocInfo.pal.priority  = Pal::GpuMemPriority::Normal;
+        allocInfo.flags.persistentMapped = true;
+
+        // Use CPU-visible pool so we can zero-init via CPU map
+        MemMgr()->GetCommonPool(InternalPoolCpuVisible, &allocInfo);
+
+        VkResult csResult = MemMgr()->AllocGpuMem(
+            allocInfo,
+            &m_criticalSectionMemory,
+            GetPalDeviceMask(),
+            VK_OBJECT_TYPE_DEVICE,
+            ApiDevice::IntValueFromHandle(ApiDevice::FromObject(this)));
+
+        if (csResult == VK_SUCCESS)
+        {
+            m_criticalSectionEnabled = true;
+
+            // Zero-initialize the lock buffer (all locks unlocked)
+            for (uint32_t deviceIdx = 0; deviceIdx < NumPalDevices(); deviceIdx++)
+            {
+                void* pCpuAddr = m_criticalSectionMemory.CpuAddr(deviceIdx);
+                if (pCpuAddr != nullptr)
+                {
+                    memset(pCpuAddr, 0, static_cast<size_t>(m_criticalSectionBufferSize));
+                }
+            }
+        }
+        // Non-fatal: if allocation fails, just disable the feature
+    }
+
     return result;
@@ -1859,2 +1904,9 @@
 
+    // Free critical section lock buffer
+    if (m_criticalSectionEnabled)
+    {
+        MemMgr()->FreeGpuMem(&m_criticalSectionMemory);
+        m_criticalSectionEnabled = false;
+    }
+
     DestroyBorderColorPalette();
