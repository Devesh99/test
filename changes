```diff
--- a/vulkandriver/drivers/xgl/icd/api/vk_compute_pipeline.cpp
+++ b/vulkandriver/drivers/xgl/icd/api/vk_compute_pipeline.cpp
@@ -888,2 +888,18 @@
 
+        // Inject critical section lock buffer GPU VA into user data SGPRs
+        if (m_pDevice->IsCriticalSectionEnabled() &&
+            m_userDataLayout.common.criticalSectionRegBase != PipelineLayout::InvalidReg)
+        {
+            const Pal::gpusize csGpuVa = m_pDevice->GetCriticalSectionGpuVa(deviceIdx);
+            const uint32_t csUserData[2] = {
+                static_cast<uint32_t>(csGpuVa & 0xFFFFFFFF),
+                static_cast<uint32_t>(csGpuVa >> 32)
+            };
+            pCmdBuffer->PalCmdBuffer(deviceIdx)->CmdSetUserData(
+                Pal::PipelineBindPoint::Compute,
+                m_userDataLayout.common.criticalSectionRegBase,
+                2,
+                csUserData);
+        }
     }
 }
